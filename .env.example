# Copy to .env for local docker-compose. Local development values only.
PG_USER=postgres
PG_PASSWORD=change-me-locally

# Slot floor (npm run floor sets all of these itself; listed for running the processes by hand)
# PGHOST=localhost PGPORT=5432 PGUSER=postgres PGPASSWORD=change-me-locally
# ANVIL_DATABASE_URL=postgres://postgres:change-me-locally@localhost:5432/ember_anvil
# ANVIL_SIGNING_KEY_ID=ember-forge-2026-11       # with ANVIL_SIGNING_KEY_PEM from a secret store; unset = fresh dev key per run
# ANVIL_FEED_TOKEN=dev-only-random                # stand-in for the platform's mTLS service identity
# CATWALK_DATABASE_URL=postgres://postgres:change-me-locally@localhost:5432/catwalk
# CATWALK_FEEDS=[{"name":"ember-anvil","url":"http://localhost:7301/v1/events","token":"dev-only-random"}]
# DEALER_URL=http://localhost:7101  CASHIER_URL=http://localhost:7102
