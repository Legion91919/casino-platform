{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.test/casino-platform/events/bonus-expired.v1.schema.json",
  "title": "BonusExpired v1",
  "description": "An award passed its expiry before wagering was met; the remaining bonus balance is forfeited.",
  "x-producer": "comps",
  "x-partition-key": "playerId",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "BonusExpired"
    },
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "const": "comps"
    },
    "data": {
      "type": "object",
      "required": [
        "awardId",
        "playerId",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "awardId": {
          "type": "string",
          "format": "uuid"
        },
        "playerId": {
          "type": "string",
          "format": "uuid",
          "x-personal-data": "pseudonymous platform player id; never a name, email or document number"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "forfeited": {
          "$ref": "envelope.v1.schema.json#/$defs/money"
        }
      }
    }
  }
}
