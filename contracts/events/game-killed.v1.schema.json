{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.test/casino-platform/events/game-killed.v1.schema.json",
  "title": "GameKilled v1",
  "description": "A kill switch stopped launches of a game (optionally one build, optionally one operator).",
  "x-producer": "dealer",
  "x-partition-key": "gameCode",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "GameKilled"
    },
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "const": "dealer"
    },
    "data": {
      "type": "object",
      "required": [
        "gameCode",
        "reason",
        "activatedBy",
        "activatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "gameCode": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "buildVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 3
        },
        "activatedBy": {
          "type": "string"
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
